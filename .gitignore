# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA output from tests/screenshots.spec.ts
/screenshots
/test-results
/playwright-report

# Figma/design reference recordings (large video files, not source)
/reference

# Claude Code: personal local settings (permission allowlist etc.),
# not meant to be shared across the team. .claude/launch.json (the dev
# server config other teammates need) is intentionally NOT ignored here.
.claude/settings.local.json
